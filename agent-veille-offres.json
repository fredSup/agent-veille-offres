    {
      "parameters": {
        "jsCode": "const resultats = [];\n\nfor (const item of $input.all()) {\n  let brut = item.json.text || '';\n  // Retire les éventuelles balises ```json ajoutées par le modèle\n  brut = brut.replace(/```json|```/g, '').trim();\n  // Garde uniquement la partie entre la première et la dernière accolade\n  const debut = brut.indexOf('{');\n  const fin = brut.lastIndexOf('}');\n  const donnees = JSON.parse(brut.slice(debut, fin + 1));\n\n  for (const offre of donnees.offres || []) {\n    resultats.push({ json: offre });\n  }\n}\n\nreturn resultats;"
      },
